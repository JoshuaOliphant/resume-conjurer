# Copy to .env (gitignored) and fill in. The live generation backend uses ANTHROPIC_API_KEY.
# Without it, the Claude Agent SDK falls back to your local authenticated `claude` CLI, which is
# fine for local dev but is not the production auth path. From 2026-06-15, Agent SDK usage on
# subscription plans draws from a separate monthly Agent SDK credit.
ANTHROPIC_API_KEY=your_api_key_here

# Optional: point the app at a workspace dir (grimoire.md, master-resume.md, applications/).
# Defaults to the bundled fixture workspace when unset.
# CONJURER_WORKSPACE=/absolute/path/to/workspace
